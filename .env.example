# Zalo Bot Platform Token (Lấy từ OA Zalo Bot Manager)
ZALO_BOT_TOKEN=your_zalo_bot_token_here

# Google Gemini API Key (Lấy từ Google AI Studio - có thể điền nhiều key phân tách bằng dấu phẩy)
GEMINI_API_KEYS=your_first_gemini_api_key_here,your_second_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-flash-latest

# Secret Token bảo mật Webhook
WEBHOOK_SECRET_TOKEN=your_random_secret_token_here

# ID Zalo của Quản trị viên (được phép chat riêng 1-1 với Bot, phân tách bằng dấu phẩy nếu nhiều ID)
ADMIN_USER_ID=your_admin_zalo_id_here
